rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /designer_designs/{designId} {
      allow create: if
        request.resource.data.designerId is string &&
        request.resource.data.designerId.size() > 0;

      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}